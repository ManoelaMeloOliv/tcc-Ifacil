# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase.
# Onde achar: painel do Supabase > Project Settings > API
VITE_SUPABASE_URL=https://seuprojeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anon_aqui

# Endpoint(s) público(s) do n8n para o frontend chamar o pipeline RAG
VITE_N8N_RAG_WEBHOOK_URL=https://n8n.seudominio.com/webhook/rag-chat
# Opcional: endpoint alternativo por ambiente/fluxo
VITE_N8N_RAG_WEBHOOK_FALLBACK_URL=

# Opcional: cabeçalho/token público adicional exigido pelo webhook
VITE_N8N_WEBHOOK_AUTH_HEADER_NAME=
VITE_N8N_WEBHOOK_AUTH_TOKEN=

# Opcional: timeout da chamada de chat (ms)
VITE_CHAT_REQUEST_TIMEOUT_MS=30000

# Segurança:
# - NUNCA exponha SERVICE_ROLE_KEY no frontend.
# - NUNCA commite segredos reais (tokens, chaves privadas, credenciais).
# - Use apenas variáveis VITE_ que podem ser públicas no browser.
