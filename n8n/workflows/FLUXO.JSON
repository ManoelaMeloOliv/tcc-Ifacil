    {
      "parameters": {
        "jsCode": "// Junta as 3 origens possíveis (agente, não-texto, erro) num único formato\nconst base = $('Normalizar mensagem').first().json;\nconst entrada = $input.first().json;\n\nlet bruto = entrada.output ?? entrada.text ?? entrada.resposta ?? '';\nif (Array.isArray(bruto)) {\n  bruto = bruto.map(p => (typeof p === 'string' ? p : (p?.text ?? ''))).join('');\n}\nbruto = String(bruto).trim();\n\nconst semInfo = /\\[\\[\\s*SEM_INFO\\s*\\]\\]/i.test(bruto);\nlet resposta = bruto.replace(/\\[\\[\\s*SEM_INFO\\s*\\]\\]/gi, '').trim();\n\n// Ajusta markdown residual para o formato do WhatsApp\nresposta = resposta\n  .replace(/\\*\\*(.+?)\\*\\*/g, '*$1*')\n  .replace(/^#{1,6}\\s*/gm, '')\n  .replace(/^\\s*\\*\\s+/gm, '- ');\n\nlet status = entrada.status_forcado || (semInfo ? 'sem_info' : 'respondida');\nif (!resposta) {\n  resposta = 'Desculpe, não consegui processar sua mensagem agora. Pode reformular a pergunta, por favor?';\n  status = 'erro';\n}\nresposta = resposta.slice(0, 3800);\n\nreturn [{ json: { ...base, pergunta: base.texto, resposta, status } }];"
      },
