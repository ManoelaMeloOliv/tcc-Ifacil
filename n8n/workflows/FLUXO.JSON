    {
      "parameters": {
        "jsCode": "// Uma linha de resumo por arquivo processado (sucesso ou erro)\nconst itens = $input.all().map(i => i.json || {});\nconst erro = itens.find(j => j.error);\nlet meta = {};\ntry { meta = $('Loop de arquivos').first().json || {}; } catch (e) { meta = {}; }\nconst chunks = itens.filter(j => j.pageContent !== undefined).length;\nlet msg = null;\nif (erro) {\n  msg = typeof erro.error === 'string' ? erro.error : (erro.error?.message || JSON.stringify(erro.error));\n}\nreturn [{ json: {\n  arquivo: meta.arquivo || meta.name || '(desconhecido)',\n  chunks: erro ? 0 : chunks,\n  ok: !erro,\n  erro: msg\n}}];"
      },
      "id": "ffebc0b7-046f-4f02-9774-4cca866a99b4",
      "name": "Resumo do arquivo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1936,
        784
      ]
    },
    {
      "parameters": {
        "jsCode": "// Chega aqui UMA vez, depois que todos os arquivos foram processados\nconst itens = $input.all().map(i => i.json || {});\nconst erros = itens.filter(i => i.ok === false);\nconst semTexto = itens.filter(i => i.ok === true && (i.chunks || 0) === 0).map(i => i.arquivo);\nconst lote = $('Definir lote e pasta').first().json.lote;\nreturn [{ json: {\n  lote,\n  arquivos_processados: itens.length,\n  com_erro: erros.length,\n  erros,\n  sem_texto: semTexto,\n  chunks_totais: itens.reduce((s, i) => s + (i.chunks || 0), 0),\n  ok: erros.length === 0 && itens.length > 0\n}}];"
      },
      "id": "f8580388-fb6f-4351-bd26-cef0bb902cb6",
