    {
      "parameters": {
        "jsCode": "// Junta as origens possíveis (agente, menu, opção, não-texto, erro) num único formato\nconst base = $('Normalizar mensagem').first().json;\nconst entrada = $input.first().json;\n\nlet bruto = entrada.output ?? entrada.text ?? entrada.resposta ?? '';\nif (Array.isArray(bruto)) {\n  bruto = bruto.map(p => (typeof p === 'string' ? p : (p?.text ?? ''))).join('');\n}\nbruto = String(bruto).trim();\n\nconst semInfo = /\\[\\[\\s*SEM_INFO\\s*\\]\\]/i.test(bruto);\nlet resposta = bruto.replace(/\\[\\[\\s*SEM_INFO\\s*\\]\\]/gi, '').trim();\n\n// Ajusta markdown residual para o formato do WhatsApp\nresposta = resposta\n  .replace(/\\*\\*(.+?)\\*\\*/g, '*$1*')\n  .replace(/^#{1,6}\\s*/gm, '')\n  .replace(/^\\s*\\*\\s+/gm, '- ');\n\nlet status = entrada.status_forcado || (semInfo ? 'sem_info' : 'respondida');\n// Qualquer falha do agente (erro ou resposta vazia) vira encaminhamento para atendente humano\nif (!entrada.status_forcado && (entrada.error || !resposta)) {\n  resposta = 'Desculpe a demora! 🙏 Um *atendente humano* já vai retornar com as informações solicitadas dentro de alguns minutos.';\n  status = 'humano';\n}\nresposta = resposta.slice(0, 3800);\n\nreturn [{ json: { ...base, pergunta: base.texto, resposta, status } }];"
      },
