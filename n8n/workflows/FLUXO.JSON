    {
      "parameters": {
        "jsCode": "// Uma linha de resumo por arquivo processado (sucesso ou erro)\nconst itens = $input.all().map(i => i.json || {});\nconst erro = itens.find(j => j.error);\nlet meta = {};\ntry { meta = $('Loop de arquivos').first().json || {}; } catch (e) { meta = {}; }\nconst chunks = itens.filter(j => j.pageContent !== undefined).length;\nlet msg = null;\nif (erro) {\n  msg = typeof erro.error === 'string' ? erro.error : (erro.error?.message || JSON.stringify(erro.error));\n}\nreturn [{ json: {\n  arquivo: meta.arquivo || meta.name || '(desconhecido)',\n  chunks: erro ? 0 : chunks,\n  ok: !erro,\n  erro: msg\n}}];"
      },
      "id": "0c9f7bcc-1baf-4633-a265-a4b76353273e",
      "name": "Resumo do arquivo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        624
      ]
    },
    {
      "parameters": {
        "jsCode": "// Chega aqui UMA vez, depois que todos os arquivos foram processados\nconst itens = $input.all().map(i => i.json || {});\nconst erros = itens.filter(i => i.ok === false);\nconst semTexto = itens.filter(i => i.ok === true && (i.chunks || 0) === 0).map(i => i.arquivo);\nconst lote = $('Definir lote e pasta').first().json.lote;\nreturn [{ json: {\n  lote,\n  arquivos_processados: itens.length,\n  com_erro: erros.length,\n  erros,\n  sem_texto: semTexto,\n  chunks_totais: itens.reduce((s, i) => s + (i.chunks || 0), 0),\n  ok: erros.length === 0 && semTexto.length === 0 && itens.length > 0\n}}];"
      },
