    {
      "parameters": {
        "jsCode": "// Extrai os campos úteis do payload da Evolution API (evento messages.upsert)\nconst raw = $input.first().json;\nconst body = raw.body ?? raw;\nconst data = body.data ?? {};\nconst key = data.key ?? {};\nconst msg = data.message ?? {};\n\nconst evento = String(body.event ?? '').toLowerCase().replace(/_/g, '.');\nconst remoteJid = String(key.remoteJid ?? '');\nconst fromMe = key.fromMe === true;\nconst isGrupo = remoteJid.endsWith('@g.us');\nconst isStatus = remoteJid.startsWith('status@') || remoteJid.endsWith('@broadcast') || remoteJid.endsWith('@newsletter');\n\nconst texto = String(\n  msg.conversation ??\n  msg.extendedTextMessage?.text ??\n  msg.imageMessage?.caption ??\n  msg.videoMessage?.caption ??\n  msg.documentMessage?.caption ??\n  ''\n).trim().slice(0, 1500);\n\nconst tipo = String(data.messageType ?? Object.keys(msg)[0] ?? 'desconhecido');\nconst ignorarTipos = ['reactionMessage', 'protocolMessage', 'senderKeyDistributionMessage',\n  'editedMessage', 'pollUpdateMessage', 'stickerMessage', 'messageContextInfo'];\n\nlet acao = 'responder';\nif (evento !== 'messages.upsert' || !remoteJid || fromMe || isGrupo || isStatus) {\n  acao = 'ignorar';\n} else if (!texto) {\n  acao = ignorarTipos.includes(tipo) ? 'ignorar' : 'nao_texto';\n}\n\nconst alt = String(key.remoteJidAlt ?? key.senderPn ?? '');\nconst telefone = (alt || remoteJid).split('@')[0].replace(/\\D/g, '');\n\nreturn [{ json: {\n  acao,\n  texto,\n  remoteJid,\n  telefone,\n  nome: String(data.pushName ?? ''),\n  messageId: String(key.id ?? ''),\n  tipo,\n  instance: String(body.instance ?? body.instanceName ?? ''),\n  evento\n}}];"
      },
